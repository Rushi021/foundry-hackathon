# --- LLM (provider-agnostic: "provider:model") ---
CATEGORIZE_LLM=openai:gpt-4o-mini
FOUNDER_LLM=openai:gpt-4o
OPENAI_API_KEY=

# Optional if you switch providers, e.g. anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# --- Research (answer-only; default Perplexity) ---
RESEARCH_PROVIDER=perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- LangSmith (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=foundry

# --- Supabase (optional; soft no-op if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
