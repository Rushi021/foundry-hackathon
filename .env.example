# --- LLM (provider-agnostic: "provider:model") ---
# API-key path: gpt-4o-mini / gpt-4o work with OPENAI_API_KEY.
# ChatGPT plan path (foundry login): those IDs are rejected — Foundry remaps
# them to plan catalog slugs (gpt-5.6-luna / gpt-6.1-sol). Prefer setting
# catalog slugs explicitly after: foundry models
# Fast model: LLM router fallback + context resolution
CATEGORIZE_LLM=openai:gpt-5.6-luna
# Co-Founder agent
FOUNDER_LLM=openai:gpt-6.1-sol
# Direct Assistant
ASSISTANT_LLM=openai:gpt-5.6-luna
# COO + specialists (research, engineering, marketing)
AGENT_LLM=openai:gpt-6.1-sol

# --- Decision router (Jev by TypeSafe AI) ---
# auto: Jev when TYPESAFE_API_KEY is set, else LLM fallback (flagged in metrics) | jev | llm
ROUTER_PROVIDER=auto
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# ROUTER_MIN_CONFIDENCE=0.45
# ROUTER_CLARIFY_THRESHOLD=0.7
# ROUTER_MEMORY_THRESHOLD=0.5

# --- Local storage: sessions + memory (gitignored) ---
FOUNDRY_DATA_DIR=.foundry

# Billing: auto (ChatGPT plan if signed in, else API key) | chatgpt | api_key
FOUNDRY_LLM_BILLING=auto

# Optional API-key path (not needed after `foundry login` with plan usage)
OPENAI_API_KEY=

# Optional if you switch providers, e.g. anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# --- Research (answer-only; default Perplexity) ---
RESEARCH_PROVIDER=perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- LangSmith (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=foundry

# --- Supabase (optional; soft no-op if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
